# ── Simalytics – proměnné prostředí ────────────────────────────────
# Neon: console.neon.tech → tvůj projekt → „Connect“ / Connection string
# Pro Next.js doporučuji POOLED string (host končí na -pooler…).
# Pro cron skript lze použít stejný (nebo přímý) string.

DATABASE_URL=postgresql://uzivatel:heslo@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Volitelné: seznam ID položek ke sledování (jinak se použije tabulka items)
# SIMCOMPANIES_ITEMS=1,2,3,11,17

# ── Simco Tools API (https://api.simcotools.com, limit 2 req/s) ─────
# Realm 0 = Magnates, 1 = Entrepreneurs
SIMCOTOOLS_REALM=0
# Jazyk názvů z API (cs, en, de, …)
SIMCOTOOLS_LANGUAGE=cs

# ── Cron poller ticků (/api/cron/ticks) ─────────────────────────────
# Volá cron-job.org každých 5 minut s hlavičkou Authorization: Bearer …
CRON_SECRET=vygeneruj-dlouhy-nahodny-retezec

# Volitelné: kvality trhu, které má cron stahovat
# SIMCOMPANIES_QUALITIES=0
